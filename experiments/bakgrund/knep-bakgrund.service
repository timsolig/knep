[Unit]
Description=knep: bakgrunden (Claude Code arbetar på natten, se experiments/bakgrund/README.md)
After=network-online.target

[Service]
Type=simple
Environment=PATH=@PATH@
ExecStart=%h/.local/share/knep-bakgrund/loop.sh
Restart=always
RestartSec=120
KillSignal=SIGINT
TimeoutStopSec=120
# Driften ska alltid hinna med sin cykel (under 4 min): bakgrunden får högst två av fyra kärnor
# och viker undan när driften behöver processorn. Minnet går inte att begränsa här, eftersom
# kärnan på Pi:n saknar minnesstyrningen i cgroup (kräver cgroup_enable=memory i cmdline.txt).
CPUQuota=200%
CPUWeight=20

[Install]
WantedBy=default.target
